#!/bin/bash

# Wiggly STT Daemon - Background dictation service
# This script should NOT be called directly - use wiggly-stt.sh instead

set -e

# Prevent direct execution by users (allow when called from main script)
if [ "${BASH_SOURCE[0]}" = "${0}" ] && [ -z "$WIGGLY_STT_INTERNAL" ]; then
    echo "Error: This script should not be called directly."
    echo "Use: wiggly-stt start-record or wiggly-stt stop-record"
    exit 1
fi

# Get script directory from environment variable or detect it
if [ -n "$WIGGLY_STT_SCRIPT_DIR" ]; then
    # Use the directory passed from the main script
    SCRIPT_DIR="$WIGGLY_STT_SCRIPT_DIR"
else
    # Fallback: try to detect (same logic as main script)
    script_path="$(readlink -f "$0")"
    script_dir="$(dirname "$script_path")"
    
    if [ -f "$script_dir/wiggly-stt.conf" ]; then
        SCRIPT_DIR="$script_dir"
    elif [ -f "/usr/share/wiggly-stt/wiggly-stt.conf" ]; then
        SCRIPT_DIR="/usr/share/wiggly-stt"
    elif [ -f "$HOME/.local/share/wiggly-stt/wiggly-stt.conf" ]; then
        SCRIPT_DIR="$HOME/.local/share/wiggly-stt"
    else
        echo "Error: Cannot find Wiggly STT installation files"
        exit 1
    fi
fi

# Set file paths
CONFIG_FILE="$SCRIPT_DIR/wiggly-stt.conf"
SHARED_FILE="$SCRIPT_DIR/wiggly-stt-shared"

# Source shared configuration
if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
else
    echo "Error: Configuration file not found: $CONFIG_FILE"
    exit 1
fi

# Source shared functions
if [ -f "$SHARED_FILE" ]; then
    source "$SHARED_FILE"
else
    echo "Error: Shared functions file not found: $SHARED_FILE"
    exit 1
fi

# Override daemon-specific audio file path
AUDIO_FILE="$DAEMON_AUDIO_FILE"

# Function to transcribe using server (daemon-specific with logging)
transcribe_via_server_daemon() {
    local audio_file="$1"
    
    echo "$(date): Transcribing via whisper-server..." >> "$LOG_FILE"
    
    # Use the shared function and add logging
    local transcription
    transcription=$(transcribe_via_server "$audio_file")
    
    if [ $? -eq 0 ] && [ -n "$transcription" ]; then
        echo "$(date): Server transcription successful" >> "$LOG_FILE"
        echo "$transcription"
        return 0
    else
        echo "$(date): Server transcription failed, falling back to CLI" >> "$LOG_FILE"
        return 1
    fi
}

# Function to transcribe using CLI (daemon-specific with logging)
transcribe_via_cli_daemon() {
    local audio_file="$1"
    
    echo "$(date): Transcribing via whisper-cli..." >> "$LOG_FILE"
    
    # Use the shared function and add logging
    local transcription
    transcription=$(transcribe_via_cli "$audio_file")
    
    if [ $? -eq 0 ] && [ -n "$transcription" ]; then
        echo "$(date): CLI transcription successful" >> "$LOG_FILE"
        echo "$transcription"
        return 0
    else
        echo "$(date): CLI transcription failed" >> "$LOG_FILE"
        return 1
    fi
}


# Check if daemon is running (alias for shared function)
is_daemon_running() {
    is_recording_active
}

# Start daemon recording
start_daemon() {
    if is_daemon_running; then
        print_error "Daemon already running (PID: $(cat "$PID_FILE"))"
        return 1
    fi
    
    setup_daemon_dir
    
    print_status "Starting Wiggly STT Daemon..."
    
    # Create the daemon process
    {
        # Log startup
        echo "$(date): Wiggly STT Daemon started" >> "$LOG_FILE"
        
        # Set up signal handlers for graceful shutdown
        cleanup_and_transcribe() {
            echo "$(date): Received stop signal, processing transcription..." >> "$LOG_FILE"
            
            # Get the notification ID for replacement (if available)
            local notification_id=""
            if [ -f "$DAEMON_DIR/notification_id" ]; then
                notification_id=$(cat "$DAEMON_DIR/notification_id")
            fi
            
            # Stop recording if running
            if [ -n "$RECORDING_PID" ]; then
                kill "$RECORDING_PID" 2>/dev/null || true
                wait "$RECORDING_PID" 2>/dev/null || true
            fi
            
            # Transcribe if we have audio
            if [ -f "$AUDIO_FILE" ] && [ -s "$AUDIO_FILE" ]; then
                echo "$(date): Starting transcription..." >> "$LOG_FILE"
                
                local transcription=""
                if is_server_running; then
                    transcription=$(transcribe_via_server_daemon "$AUDIO_FILE")
                else
                    transcription=$(transcribe_via_cli_daemon "$AUDIO_FILE")
                fi
                
                if [ -n "$transcription" ]; then
                    # Copy to clipboard
                    echo -n "$transcription" | wl-copy 2>/dev/null || true
                    
                    # Auto-paste immediately if flag is set
                    if [ -f "$DAEMON_DIR/auto_paste_flag" ]; then
                        echo "$(date): Auto-paste requested, pasting immediately..." >> "$LOG_FILE"
                        if command -v ydotool >/dev/null 2>&1; then
                            ydotool key 29:1 47:1 47:0 29:0
                            echo "$(date): Text auto-pasted via ydotool" >> "$LOG_FILE"
                        fi
                        rm -f "$DAEMON_DIR/auto_paste_flag"  # Clean up flag
                    fi
                    
                    # Replace notification with transcription result
                    if [ -n "$notification_id" ]; then
                        replace_notification "$notification_id" "🎤 Wiggly STT" "Transcription complete!\n\n$transcription" \
                            "audio-input-microphone" "normal" "10000"
                    else
                        # Fallback to new notification if no ID available
                        send_notification "🎤 Wiggly STT" "Transcription complete!\n\n$transcription" \
                            "audio-input-microphone" "normal" "10000"
                    fi
                    
                    # Log the result
                    echo "$(date): Transcription: $transcription" >> "$LOG_FILE"
                    
                    # Save to file for retrieval
                    echo "$transcription" > "$DAEMON_DIR/last_transcription.txt"
                else
                    # Replace notification with failure message
                    if [ -n "$notification_id" ]; then
                        replace_notification "$notification_id" "🎤 Wiggly STT" "No speech detected in recording" \
                            "dialog-warning" "normal" "5000"
                    else
                        # Fallback to new notification if no ID available
                        send_notification "🎤 Wiggly STT" "No speech detected in recording" \
                            "dialog-warning" "normal" "5000"
                    fi
                    
                    echo "$(date): No transcription generated" >> "$LOG_FILE"
                fi
            else
                # Replace notification with no audio message
                if [ -n "$notification_id" ]; then
                    replace_notification "$notification_id" "🎤 Wiggly STT" "No audio recorded" \
                        "dialog-error" "normal" "5000"
                else
                    # Fallback to new notification if no ID available
                    send_notification "🎤 Wiggly STT" "No audio recorded" \
                        "dialog-error" "normal" "5000"
                fi
                
                echo "$(date): No audio file found" >> "$LOG_FILE"
            fi
            
            # Cleanup
            rm -f "$AUDIO_FILE"
            rm -f "$PID_FILE"
            rm -f "$DAEMON_DIR/notification_id"  # Clean up notification ID
            echo "$(date): Daemon stopped" >> "$LOG_FILE"
            exit 0
        }
        
        # Set up signal traps
        trap cleanup_and_transcribe TERM INT USR1
        
        # Start continuous recording
        echo "$(date): Starting continuous recording..." >> "$LOG_FILE"
        
        # Use ffmpeg to record continuously until killed
        ffmpeg -f pulse -i default -ar $SAMPLE_RATE "$AUDIO_FILE" -y 2>/dev/null &
        RECORDING_PID=$!
        
        echo "$(date): Recording started (PID: $RECORDING_PID)" >> "$LOG_FILE"
        
        # Wait for signals
        wait "$RECORDING_PID" 2>/dev/null || true
        
        # If we get here, recording ended naturally (shouldn't happen in daemon mode)
        echo "$(date): Recording ended unexpectedly" >> "$LOG_FILE"
        cleanup_and_transcribe
        
    } &
    
    # Save daemon PID
    local daemon_pid=$!
    echo "$daemon_pid" > "$PID_FILE"
    
    print_success "Daemon started (PID: $daemon_pid)"
    print_status "Log file: $LOG_FILE"
    print_status "Stop with: ./wiggly-stt.sh stop-record"
    
    # Send startup notification (suppress ID output)
    send_notification "🎤 Wiggly STT" "Background dictation started\nSpeak freely, stop with: ./wiggly-stt.sh stop-record" \
        "audio-input-microphone" "low" "3000" >/dev/null 2>&1
}

# Stop daemon
stop_daemon() {
    local auto_paste=${1:-false}
    
    if ! is_daemon_running; then
        print_error "No daemon running"
        return 1
    fi
    
    local pid=$(cat "$PID_FILE")
    print_status "Stopping daemon (PID: $pid) and processing transcription..."
    
    # Write auto-paste flag for daemon to check
    if [ "$auto_paste" = true ]; then
        touch "$DAEMON_DIR/auto_paste_flag"
    fi
    
    # Send immediate notification and store ID for replacement
    local transcription_notification_id
    send_notification_with_id transcription_notification_id "🎤 Wiggly STT" "Processing transcription..." \
        "media-playback-stop" "low" "30000"
    
    # Store the notification ID for the daemon process to use
    echo "$transcription_notification_id" > "$DAEMON_DIR/notification_id"
    
    # Send signal to stop and transcribe
    kill -USR1 "$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    
    # Wait for daemon to finish
    local count=0
    while is_daemon_running && [ $count -lt 30 ]; do
        sleep 1
        count=$((count + 1))
    done
    
    if is_daemon_running; then
        print_warning "Daemon didn't stop gracefully, forcing termination..."
        kill -KILL "$pid" 2>/dev/null || true
        rm -f "$PID_FILE"
        
        # Replace with error notification if forced termination
        replace_notification "$transcription_notification_id" "🎤 Wiggly STT" "Recording stopped forcefully\nTranscription may be incomplete" \
            "dialog-warning" "normal" "5000"
    fi
    
    print_success "Daemon stopped and transcription completed"
    
    # Show last transcription if available
    if [ -f "$DAEMON_DIR/last_transcription.txt" ]; then
        local transcription=$(cat "$DAEMON_DIR/last_transcription.txt")
        print_status "Last transcription: $transcription"
    fi
}

# Get daemon status
daemon_status() {
    if is_daemon_running; then
        local pid=$(cat "$PID_FILE")
        print_success "Daemon is running (PID: $pid)"
        
        # Show how long it's been running
        if [ -f "$LOG_FILE" ]; then
            local start_time=$(grep "Daemon started" "$LOG_FILE" | tail -1 | cut -d: -f1-3)
            print_status "Started: $start_time"
        fi
        
        # Show recent log entries
        if [ -f "$LOG_FILE" ]; then
            echo "Recent log entries:"
            tail -5 "$LOG_FILE" | sed 's/^/  /'
        fi
    else
        print_status "Daemon is not running"
        
        # Show last transcription if available
        if [ -f "$DAEMON_DIR/last_transcription.txt" ]; then
            local transcription=$(cat "$DAEMON_DIR/last_transcription.txt")
            print_status "Last transcription: $transcription"
        fi
    fi
}

# Check dependencies
check_dependencies() {
    local missing_deps=()
    
    if ! command -v ffmpeg >/dev/null 2>&1; then
        missing_deps+=("ffmpeg")
    fi
    
    if ! command -v whisper-cli >/dev/null 2>&1; then
        missing_deps+=("whisper-cli")
    fi
    
    if ! command -v wl-copy >/dev/null 2>&1; then
        missing_deps+=("wl-clipboard")
    fi
    
    if ! command -v notify-send >/dev/null 2>&1; then
        missing_deps+=("libnotify (notify-send)")
    fi
    
    if [ ${#missing_deps[@]} -ne 0 ]; then
        print_error "Missing dependencies: ${missing_deps[*]}"
        exit 1
    fi
    
    # Check model exists
    if [ ! -f "$MODEL_PATH/$DEFAULT_MODEL" ]; then
        print_error "Model not found: $MODEL_PATH/$DEFAULT_MODEL"
        exit 1
    fi
}

# Show usage
usage() {
    cat << EOF
Wiggly STT Daemon - Background Dictation Service

Usage: $0 [COMMAND] [OPTIONS]

Commands:
    --start, -s              Start daemon in background
    --stop, -x               Stop daemon and transcribe
    --status, --st           Show daemon status
    --restart, -r            Restart daemon
    --help, -h               Show this help

Options:
    -m, --model MODEL        Whisper model to use (default: $DEFAULT_MODEL)
    -p, --auto-paste         Auto-paste transcribed text (only with --stop)

Workflow:
    1. Start daemon: $0 --start
    2. Speak 
    3. Stop when done: $0 --stop [-p]
    4. After transcription is complete, notification is fired and text is 
       put onto the clipboard; with [-p] it is also pasted.

Examples:
    $0 --start               # Start background dictation
    $0 --stop                # Stop and get transcription
    $0 --stop -p             # Stop and auto-paste transcription
    $0 --status              # Check if running
    $0 --restart             # Restart daemon

EOF
}

# Main function
main() {
    local command=""
    local auto_paste_flag=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --start|-s)
                command="start"
                shift
                ;;
            --stop|-x)
                command="stop"
                shift
                ;;
            --status|--st)
                command="status"
                shift
                ;;
            --restart|-r)
                command="restart"
                shift
                ;;
            -m|--model)
                DEFAULT_MODEL="$2"
                shift 2
                ;;
            -p|--auto-paste)
                auto_paste_flag=true
                shift
                ;;
            --help|-h)
                usage
                exit 0
                ;;
            *)
                print_error "Unknown option: $1"
                usage
                exit 1
                ;;
        esac
    done
    
    # Default to status if no command given
    if [ -z "$command" ]; then
        command="status"
    fi
    
    # Validate auto-paste flag usage
    if [ "$auto_paste_flag" = true ] && [ "$command" != "stop" ]; then
        print_error "Auto-paste (-p) can only be used with --stop command"
        usage
        exit 1
    fi
    
    # Execute command
    case $command in
        start)
            check_dependencies
            start_daemon
            ;;
        stop)
            check_dependencies
            stop_daemon $auto_paste_flag
            ;;
        status)
            daemon_status
            ;;
        restart)
            check_dependencies
            if is_daemon_running; then
                stop_daemon false
                sleep 2
            fi
            start_daemon
            ;;
        *)
            print_error "Unknown command: $command"
            usage
            exit 1
            ;;
    esac
}

# Run main function
main "$@" 